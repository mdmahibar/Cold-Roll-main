# ============================================================
#  SAP Proxy API  —  SERVER environment
#  This file is the ONLY place SAP credentials exist.
#  Never commit the real .env. Never copy these into the client.
# ============================================================

# ---- Server ----
NODE_ENV=production
PORT=4100
HOST=0.0.0.0

# Leave EMPTY in production. IIS serves the React build and proxies /api to
# this service, so requests are same-origin and CORS is not involved.
# For local dev with Vite on 5173, set: http://localhost:5173
CORS_ORIGIN=

BODY_LIMIT=10mb
REQUEST_TIMEOUT_MS=120000

# ---- SAP B1 Service Layer ----
SAP_URL=https://dts.connectcloud365.com:59792/b1s/v2
SAP_COMPANY_DB=MSFPL_TEST
SAP_USER=manager
SAP_PASSWORD=CHANGE_ME

# Service Layer usually ships a self-signed certificate.
# false = accept it (equivalent to Vite's `secure: false`).
# Set true once a properly trusted certificate is installed on SAP.
SAP_REJECT_UNAUTHORIZED=false

SAP_TIMEOUT_MS=120000
SAP_SESSION_MINUTES=30
SAP_SESSION_REFRESH_RATIO=0.8
SAP_MAX_LOGIN_RETRIES=2

# ---- Endpoint allowlist (optional hardening) ----
# false = every Service Layer entity is reachable (same as the old direct
# setup). Switch to true once you know your entity list; then the browser
# can only reach what you name here.
SAP_ENFORCE_ALLOWLIST=false
SAP_ALLOWED_ENTITIES=Items,BusinessPartners,Warehouses,PurchaseOrders,PurchaseRequests,PurchaseDeliveryNotes,StockTransfers,InventoryGenEntries,InventoryGenExits,ProductionOrders,ProductTrees,InventoryTransferRequests,BatchNumberDetails,SeriesService_GetDocumentSeries,States,ItemGroups,SQLQueries

# ---- Logging ----
LOG_LEVEL=info
LOG_SAP_CALLS=true
