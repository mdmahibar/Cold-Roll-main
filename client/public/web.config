<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the Cold Roll React (Vite) client.

  This is the master copy. It lives in /public so that `npm run build` copies
  it into /dist automatically — no separate copy step at deploy time.

  WHAT CHANGED FROM THE PREVIOUS VERSION:

  The browser no longer talks to SAP. IIS now forwards /api/sap/* to the Node
  service on port 4100, which holds the SAP credentials and one pooled
  Service Layer session.

  Three things that used to be required are now unnecessary:
    - The ARR server farm "sapb1" (Deployment\Fix-SapProxy.ps1). The
      self-signed certificate is accepted by Node instead, in one place you
      control rather than on every machine.
    - Importing the SAP certificate on each host.
    - Any Set-Cookie path rewriting. B1SESSION never reaches the browser.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <clear />

        <!-- 1. SAP proxy. Browser /api/sap/Login -> Node :4100 -> Service Layer.
             Scoped to /api/sap deliberately, so the bare /api prefix stays free
             for the business API (config.xml REACT_APP_API_ROOT) if you ever
             switch that from an absolute URL to a relative one. -->
        <rule name="SAP Proxy (Node)" stopProcessing="true">
          <match url="^api/sap/(.*)" />
          <action type="Rewrite" url="http://localhost:4100/api/sap/{R:1}" />
        </rule>

        <!-- 2. Health endpoints, for uptime monitoring from outside the box. -->
        <rule name="SAP API Health" stopProcessing="true">
          <match url="^api/health(.*)" />
          <action type="Rewrite" url="http://localhost:4100/api/health{R:1}" />
        </rule>

        <!-- 3. Optional business API proxy. Enable this and set
             REACT_APP_API_ROOT to "/api" in config.xml to avoid CORS,
             and to avoid mixed content once the site runs on HTTPS. -->
        <!--
        <rule name="Business API Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://dts.connectcloud365.com:12902/api/{R:1}" />
        </rule>
        -->

        <!-- 4. Real files (js, css, images, config.xml) are served as-is. -->
        <rule name="Static Files" stopProcessing="true">
          <match url="." />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- 5. Everything else is a React Router path -> index.html. -->
        <rule name="SPA Fallback">
          <match url=".*" />
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>
    </rewrite>

    <!-- Let SAP's own 4xx/5xx bodies reach the browser instead of an IIS error
         page. Without this, a SAP validation error shows as a blank IIS page
         and sapErrorMessage() has nothing to read. -->
    <httpErrors existingResponse="PassThrough" />

    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <!-- SAP $filter / $select query strings get long. -->
        <requestLimits maxQueryString="8192" maxUrl="8192" maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

  </system.webServer>

  <!-- index.html must never be cached, or users get a stale app after deploy. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- config.xml is edited per environment; always read fresh. -->
  <location path="config.xml">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Vite hashes asset filenames, so they can be cached forever. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
