# ============================================================
#  CLIENT environment  (Vite)
#
#  WARNING: every VITE_* value is compiled into the JS bundle and
#  is publicly readable. NEVER put the SAP password here.
#  It lives in server/.env only.
# ============================================================

# Where the SAP proxy lives. Relative on purpose — Vite proxies it in dev,
# IIS proxies it in production. Leave as-is unless you mount the API elsewhere.
VITE_SAP_API_BASE=/api/sap

# Client-side timeout for SAP calls, milliseconds.
VITE_SAP_TIMEOUT_MS=120000

# B1 user code stamped as Requester on Purchase Requests.
# A username, not a credential — safe to ship. The password is not here.
VITE_SAP_REQUESTER=

# Node service address used by the Vite dev proxy ONLY (see vite.config.js).
VITE_DEV_API_TARGET=http://localhost:4100
